# Copy to .env (DO NOT COMMIT .env to source control)
# Provide the Supabase project URL and the service role key here for server-side usage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# If you need to expose a client anon key to the frontend, provide it to the frontend app only via secure env and never commit
SUPABASE_ANON_KEY=your-anon-key
PORT=8080
